<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleDisplayName</key>
    <string>Football</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>NSHealthShareUsageDescription</key>
    <string>Football reads live heart rate, distance, and workout data while you record a session.</string>
    <key>NSHealthUpdateUsageDescription</key>
    <string>Football saves your recorded football sessions as workouts in Health.</string>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Football uses location during an outdoor session to measure distance and future route quality.</string>
    <key>NSMotionUsageDescription</key>
    <string>Football records wrist motion during a session to measure capture quality for your private performance analysis.</string>
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
    </array>
    <key>WKBackgroundModes</key>
    <array>
        <string>workout-processing</string>
    </array>
    <key>WKApplication</key>
    <true/>
    <key>WKCompanionAppBundleIdentifier</key>
    <string>com.prateekranka.footballperformance</string>
    <key>WKRunsIndependentlyOfCompanionApp</key>
    <true/>
</dict>
</plist>
